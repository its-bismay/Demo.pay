# Server
PORT=3001
NODE_ENV=production

# Database (Neon Serverless Postgres — use the POOLED connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash — must set maxRetriesPerRequest: null and TLS)
REDIS_URL=rediss://default:password@host:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Gemini
GOOGLE_API_KEY=AIza...

# External Email Service
EMAIL_SERVICE_URL=https://email-service-coral-beta.vercel.app/api/send-mail

# Seeded merchant ID (generated once on first seed run, hardcoded after)
MERCHANT_ID=e7b8c2a1-4f9e-4a6c-9b5d-8e2a1b3c4d5e

# CORS — set to Vercel frontend URL in production
FRONTEND_ORIGIN=https://your-app.vercel.app
